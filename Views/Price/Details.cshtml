@model DotNetCoreSqlDb.Models.Price
@{
    ViewData["Title"] = "Price Details";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-info text-white">
            <h4 class="mb-0">Price Details</h4>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Item Name</dt>
                <dd class="col-sm-9">@Model.ItemName</dd>
                <dt class="col-sm-3">Amount</dt>
                <dd class="col-sm-9">@Model.Amount</dd>
                <dt class="col-sm-3">Updated Date</dt>
                <dd class="col-sm-9">@Model.UpdatedDate</dd>
            </dl>
            <a asp-action="Edit" asp-route-id="@Model.ID" class="btn btn-primary">Edit</a>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </div>
</div>