@model DotNetCoreSqlDb.Models.Price

@{
    ViewData["Title"] = "Price Details";
}

<h1>Price Details</h1>

<div>
    <h4>Price</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Item Name</dt>
        <dd class="col-sm-10">@Model.ItemName</dd>
        <dt class="col-sm-2">Amount</dt>
        <dd class="col-sm-10">@Model.Amount</dd>
        <dt class="col-sm-2">Updated Date</dt>
        <dd class="col-sm-10">@Model.UpdatedDate</dd>
    </dl>
</div>
<p>
    <a asp-action="Edit" asp-route-id="@Model.ID">Edit</a> |
    <a asp-action="Index">Back to List</a>
</p>
