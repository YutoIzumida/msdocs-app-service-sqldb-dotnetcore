@model DotNetCoreSqlDb.Models.Price
@{
    ViewData["Title"] = "Delete Price";
}

<div class="container mt-4">
    <div class="card border-danger shadow-sm">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">Delete Price</h4>
        </div>
        <div class="card-body">
            <p>Are you sure you want to delete this price?</p>
            <dl class="row">
                <dt class="col-sm-3">Item Name</dt>
                <dd class="col-sm-9">@Model.ItemName</dd>
                <dt class="col-sm-3">Amount</dt>
                <dd class="col-sm-9">@Model.Amount</dd>
                <dt class="col-sm-3">Updated Date</dt>
                <dd class="col-sm-9">@Model.UpdatedDate</dd>
            </dl>
            <form asp-action="DeleteConfirmed">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ID" />
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
